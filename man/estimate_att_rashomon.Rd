  X, A, Y,
  K = 5
  # rashomon_bound_multiplier = NULL -> optimaltrees::select_epsilon_n(nrow(X))
  # cv_regularization = TRUE is the default
)
print(fit$theta)   # Point estimate (shared-structure display estimate)
print(fit$ci_95)   # 95\\% HONEST bias-aware confidence interval
}
